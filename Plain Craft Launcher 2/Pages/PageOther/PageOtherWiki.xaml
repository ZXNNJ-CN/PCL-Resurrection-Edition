<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageOtherWiki"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15,0,15" Title="搜索 Minecraft Wiki" x:Name="CardSearch">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock Text="在中文 Minecraft Wiki 中搜索游戏内容、合成配方、指令与机制说明，结果将在浏览器中打开。" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextSearch" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSearch" Text="搜索" MinWidth="120" Padding="13,0" Margin="15,0,0,0" ColorType="Highlight" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="常用页面" x:Name="CardLinks">
                <StackPanel Margin="25,40,25,15">
                    <StackPanel x:Name="PanWikiLinks" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
