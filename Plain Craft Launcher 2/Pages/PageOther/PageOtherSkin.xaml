<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageOtherSkin"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <local:MyCard Margin="0,15,0,15" Title="皮肤制作" x:Name="CardTop">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock Text="导入或从零制作 Minecraft 皮肤（64×64），支持 Steve（经典臂）与 Alex（纤细臂）两种模型，编辑结果实时同步到右侧 3D 预览。完成后导出 PNG，即可在游戏中上传使用。" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnNew" Text="新建空白" MinWidth="110" Padding="13,0" Margin="0,0,15,0" />
                        <local:MyButton Grid.Column="1" x:Name="BtnImport" Text="导入皮肤" MinWidth="110" Padding="13,0" Margin="0,0,15,0" />
                        <local:MyButton Grid.Column="2" x:Name="BtnExport" Text="导出皮肤" MinWidth="110" Padding="13,0" Margin="0,0,15,0" ColorType="Highlight" />
                        <local:MyButton Grid.Column="3" x:Name="BtnApply" Text="应用为离线皮肤" MinWidth="140" Padding="13,0" Margin="0,0,15,0" ToolTip="将当前作品设置为离线登录的皮肤，下次启动离线版游戏生效" />
                        <local:MyButton Grid.Column="4" x:Name="BtnUndo" Text="撤销" MinWidth="110" Padding="13,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="模型：" VerticalAlignment="Center" Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                            <local:MyRadioButton x:Name="RadioSteve" Text="Steve（经典）" Checked="True" Margin="0,0,10,0" />
                            <local:MyRadioButton x:Name="RadioAlex" Text="Alex（纤细）" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="像素编辑器（64×64）" x:Name="CardEditor">
                <StackPanel Margin="25,40,25,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="工具：" VerticalAlignment="Center" Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Margin="5,0,20,0">
                            <local:MyRadioButton x:Name="ToolPen" Text="画笔" Checked="True" Margin="0,0,10,0" />
                            <local:MyRadioButton x:Name="ToolEraser" Text="橡皮" Margin="0,0,10,0" />
                            <local:MyRadioButton x:Name="ToolPick" Text="取色" />
                        </StackPanel>
                        <Border x:Name="ColorPreview" Width="26" Height="26" CornerRadius="4" BorderThickness="1" BorderBrush="#66000000" VerticalAlignment="Center" />
                        <TextBlock x:Name="LabColor" Text="#FFD2691E" VerticalAlignment="Center" Margin="8,0,15,0" Opacity="0.7" />
                        <local:MyTextBox x:Name="TextHex" Width="105" HintText="如 #FF8B4514" MaxLength="9" VerticalAlignment="Center" />
                        <local:MyButton x:Name="BtnSetColor" Text="设置颜色" MinWidth="100" Padding="13,0" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Board" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#44000000" BorderThickness="1" Background="#FF3C3C46">
                            <Border x:Name="BoardInner" Width="512" Height="512">
                                <Grid>
                                    <Rectangle x:Name="RectChecker" />
                                    <Image x:Name="ImgEditor" Width="512" Height="512" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <Canvas x:Name="PanPaint" Background="#01FFFFFF" Cursor="Cross" />
                                </Grid>
                            </Border>
                        </Border>
                        <WrapPanel x:Name="PanPalette" Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="提示：上层（头套、外套等）为半透明覆盖层，画上后会在 3D 预览中叠加显示；橡皮可擦除上层像素。" Opacity="0.55" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="3D 预览" x:Name="CardPreview">
                <StackPanel Margin="25,40,25,15">
                    <Border x:Name="ViewportBorder" Height="360" CornerRadius="6" Background="#FF2B2B33" ClipToBounds="True">
                        <Viewport3D x:Name="Viewport" ClipToBounds="True" />
                    </Border>
                    <Grid Height="35" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnResetView" Text="重置视角" MinWidth="110" Padding="13,0" />
                    </Grid>
                    <TextBlock Text="在预览区按住拖动即可旋转模型。" Opacity="0.55" Margin="0,8,0,0" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
