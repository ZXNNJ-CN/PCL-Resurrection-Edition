<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDownloadJava"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyHint Theme="Blue" Text="这里可以下载 Mojang 官方提供的 Java 运行时（自动使用镜像加速）。
下载后启动游戏时 PCL 会自动选择合适的 Java，无需手动配置。" Margin="0,15,0,15" />
            <local:MyCard Margin="0,0,0,15" Title="下载 Java" x:Name="CardDownload">
                <StackPanel Margin="25,40,25,15">
                    <Grid Height="35" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="Java 版本" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Column="1" x:Name="ComboJavaVersion" IsEnabled="False" />
                        <local:MyButton Grid.Column="2" x:Name="BtnJavaDownload" Text="下载" MinWidth="140" Padding="13,0" Margin="15,0,0,0" ColorType="Highlight" IsEnabled="False" />
                    </Grid>
                    <TextBlock x:Name="LabJavaListState" Text="正在获取可下载的 Java 列表……" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="已安装的 Java" x:Name="CardInstalled">
                <StackPanel Margin="25,40,25,15">
                    <StackPanel x:Name="PanJavaInstalled" />
                    <TextBlock x:Name="LabJavaInstalledState" Text="正在获取已安装的 Java……" Opacity="0.6" TextWrapping="Wrap" />
                    <Grid Height="35" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnJavaRescan" Text="重新扫描本机 Java" MinWidth="160" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyButton Grid.Column="1" x:Name="BtnJavaImport" Text="手动导入 Java 文件夹" MinWidth="160" Padding="13,0" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
